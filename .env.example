# Copy to .env and fill in. Never commit .env.

# AI provider: anthropic (default) | groq | openai | mock
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Groq configuration: set AI_PROVIDER=groq and AI_MODEL=openai/gpt-oss-120b
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_SEARCH_MODEL=openai/gpt-oss-20b

# Groq GPT-OSS browser search works with GROQ_API_KEY automatically.
# Optional alternative search provider (takes priority when configured)
# https://docs.tavily.com/documentation/api-reference/endpoint/search
TAVILY_API_KEY=

# Optional overrides
# DATABASE_URL=sqlite:///./database/studentreplica.db
# Hosted storage: use a dedicated PostgreSQL / Supabase database and keep this URL private.
# Note: Special characters in passwords (such as @) must be URL-encoded (e.g. @ -> %40).
# For Supabase IPv4 compatibility, use the Supavisor pooler hostname:
# DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:PASSWORD@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# Docker Compose backend password; do not reuse an account or AI password.
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
MAX_PROMPT_CHARS=24000
MAX_CHAT_HISTORY=12
AI_RATE_LIMIT_PER_MINUTE=20
