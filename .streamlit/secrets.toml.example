# Example only. Put the real key in Streamlit Cloud App settings > Secrets.
# Never commit a real .streamlit/secrets.toml file.
AI_PROVIDER = "groq"
AI_MODEL = "openai/gpt-oss-120b"
GROQ_API_KEY = "replace-with-your-groq-key"

# Optional persistent cloud storage. Replace placeholders before enabling.
# Keep DATABASE_URL at the top level, or use the [database] section below.
# DATABASE_URL = "postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# [database]
# url = "postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
